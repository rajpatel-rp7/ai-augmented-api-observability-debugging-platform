# Application
APP_ENV=development
APP_NAME=observability-platform
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (matches docker-compose defaults)
POSTGRES_USER=observability
POSTGRES_PASSWORD=observability
POSTGRES_DB=observability
DATABASE_URL=postgresql+psycopg://observability:observability@postgres:5432/observability

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_LOGS_INDEX=observability-logs
ELASTICSEARCH_PORT=9200

# Redis Streams
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
REDIS_LOGS_STREAM=telemetry.logs
REDIS_INCIDENT_EVENTS_STREAM=telemetry.incident-events
REDIS_DETECTION_CONSUMER_GROUP=detection-workers

# Jaeger
JAEGER_QUERY_URL=http://jaeger:16686
JAEGER_ZIPKIN_URL=http://jaeger:9411
JAEGER_UI_PORT=16686
JAEGER_ZIPKIN_PORT=9411

# Observability UI ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
